<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE, INFOPLIST_KEY_*). -->
<plist version="1.0">
<dict>
	<!-- Without it, iPhones with ProMotion run the app's animations and scrolling at 60 Hz. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Documents shows up in the Files app ("On My iPhone"). Xcode does not
	     generate this one from INFOPLIST_KEY_UIFileSharingEnabled. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Export compliance (D51): the app's own encryption is HTTPS through
	     URLSession and WebKit and the Keychain, all Apple's; Python's hashlib
	     only hashes. App Store Connect then asks no questions per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- What programs may ask for through the device modules (D40). -->
	<key>NSCameraUsageDescription</key>
	<string>Your programs can take photos with the camera (photos.capture_image).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Your programs can read and edit photos in your library (the photos module).</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Your programs can save images to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your programs can use your location (the location module).</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Your programs can record audio (sound.Recorder).</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your programs can transcribe recorded speech (speech.recognize).</string>
	<key>NSContactsUsageDescription</key>
	<string>Your programs can read and change your contacts (the contacts module).</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Your programs can read and change your reminders (the reminders module).</string>
	<key>NSMotionUsageDescription</key>
	<string>Your programs can read the motion sensors (the motion module).</string>
	<!-- pyslopnista://run?path=<path> runs a program (D38): Home Screen
	     shortcuts made with an Open URL action, links. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>eu.ronacher.Pyslopnista</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pyslopnista</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
